function processarPlanilha(e) {
    const file = e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = function(evt) {
        const data = new Uint8Array(evt.target.result);
        const workbook = XLSX.read(data, {type: 'array'});
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        const json = XLSX.utils.sheet_to_json(worksheet, {header: 1});
        
        let processados = [];
        for(let i = 1; i < json.length; i++) {
            let row = json[i];
            if(row && row.length > 0 && (row[0] || row[2])) {
                processados.push({
                    pasta: row[0] || '',
                    num_processo: row[1] || '',
                    criancas: row[2] || '',
                    nasc: row[3] || '',
                    responsavel: row[4] || '',
                    endereco: row[5] || '',
                    cidade: row[6] || 'Paranoá',
                    assunto: row[7] || '',
                    conselheiro: row[8] || '',
                    processo_sei: row[9] || ''
                });
            }
        }
        
        if(processados.length > 0) {
            enviarLoteImportacao(processados);
        } else {
            alert("Nenhum dado válido encontrado na planilha.");
        }
    };
    reader.readAsArrayBuffer(file);
}

function clicarColar() {
    const texto = document.getElementById("pasteInput").value.trim();
    if(!texto) {
        alert("Cole os dados na caixa de texto!");
        return;
    }
    const linhas = texto.split("\n");
    let processados = [];
    linhas.forEach(linha => {
        const cols = linha.split("\t");
        if(cols.length >= 2) {
            processados.push({
                pasta: cols[0] ? cols[0].trim() : '',
                num_processo: cols[1] ? cols[1].trim() : '',
                criancas: cols[2] ? cols[2].trim() : '',
                nasc: cols[3] ? cols[3].trim() : '',
                responsavel: cols[4] ? cols[4].trim() : '',
                endereco: cols[5] ? cols[5].trim() : '',
                cidade: cols[6] ? cols[6].trim() : 'Paranoá',
                assunto: cols[7] ? cols[7].trim() : '',
                conselheiro: cols[8] ? cols[8].trim() : '',
                processo_sei: cols[9] ? cols[9].trim() : ''
            });
        }
    });

    if(processados.length > 0) {
        enviarLoteImportacao(processados);
    } else {
        alert("Formato inválido ou vazio.");
    }
}

function enviarLoteImportacao(dados) {
    const formData = new URLSearchParams();
    formData.append('acao', 'importar_processos_lote');
    formData.append('dados', JSON.stringify(dados));

    fetch('index.php', { method: 'POST', body: formData })
        .then(res => res.json())
        .then(resp => {
            alert(`Importação concluída! Sucessos: ${resp.sucessos}`);
            carregarProcessos();
            atualizarDashboardEstatisticas();
            document.getElementById("pasteInput").value = "";
        });
}

function tentarLimparFormulario() {
    cancelarEdicao();
}

function apagarTudo() {
    if(!confirm("ATENÇÃO: Deseja realmente apagar TODOS os registros do banco de dados?")) return;
    
    const formData = new URLSearchParams();
    formData.append('acao', 'apagar_tudo');

    fetch('index.php', { method: 'POST', body: formData })
        .then(res => res.json())
        .then(resp => {
            alert(resp.message);
            carregarProcessos();
            carregarAtendimentos();
            atualizarDashboardEstatisticas();
        });
}

function abrirHistorico(id, pasta) {
    document.getElementById("modalHistorico").style.display = "flex";
    document.getElementById("modalTituloPasta").innerHTML = `<i class="fa-solid fa-clock-rotate-left"></i> HISTÓRICO - PASTA: ${pasta}`;
    document.getElementById("historicoIndexAtual").value = id;
    carregarHistoricoServicos(id);
}

function fecharModalHistorico() {
    document.getElementById("modalHistorico").style.display = "none";
}

function carregarHistoricoServicos(processoId) {
    fetch(`index.php?acao=listar_historico&processo_id=${processoId}`)
        .then(res => res.json())
        .then(data => {
            const tbody = document.querySelector("#tabelaHistoricoServicos tbody");
            if(!tbody) return;
            if(data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: var(--text-light); padding: 12px; font-size: 13px;">NENHUM SERVIÇO.</td></tr>`;
                return;
            }
            let html = "";
            data.forEach(item => {
                html += `
                    <tr>
                        <td>${item.data_servico || ''}</td>
                        <td>${item.conselheiro || ''}</td>
                        <td>${item.descricao || ''}</td>
                        <td style="text-align: center;"><button type="button" class="btn-remove" style="width:22px; height:22px; display:inline-flex;" onclick="excluirHistoricoServico(${item.id}, ${processoId})"><i class="fa-solid fa-xmark"></i></button></td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        });
}

function adicionarNovoServicoNaPasta() {
    const processoId = document.getElementById("historicoIndexAtual").value;
    const data = document.getElementById("novoServicoData").value;
    const conselheiro = document.getElementById("novoServicoConselheiro").value;
    const descricao = document.getElementById("novoServicoDescricao").value;

    if(!data || !descricao) {
        alert("Preencha a data e a descrição do serviço!");
        return;
    }

    const formData = new URLSearchParams();
    formData.append('acao', 'salvar_historico');
    formData.append('processo_id', processoId);
    formData.append('data_servico', data);
    formData.append('conselheiro', conselheiro);
    formData.append('descricao', descricao);

    fetch('index.php', { method: 'POST', body: formData })
        .then(() => {
            document.getElementById("novoServicoData").value = "";
            document.getElementById("novoServicoConselheiro").value = "";
            document.getElementById("novoServicoDescricao").value = "";
            carregarHistoricoServicos(processoId);
        });
}

function excluirHistoricoServico(id, processoId) {
    if(!confirm("Excluir este serviço?")) return;
    const formData = new URLSearchParams();
    formData.append('acao', 'excluir_historico');
    formData.append('id', id);

    fetch('index.php', { method: 'POST', body: formData })
        .then(() => carregarHistoricoServicos(processoId));
}
