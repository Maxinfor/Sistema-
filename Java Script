document.addEventListener("DOMContentLoaded", function () {
    atualizarDataHoraHeader();
    carregarProcessos();
    carregarAtendimentos();
    atualizarDashboardEstatisticas();
    configurarAutocompleteAssuntos();
    configurarAutocompleteAtendAssuntos();
    
    const hoje = new Date().toLocaleDateString('pt-BR');
    if(document.getElementById("spanDataHoje")) document.getElementById("spanDataHoje").textContent = hoje;
    if(document.getElementById("atendDataHora")) document.getElementById("atendDataHora").value = new Date().toLocaleString('pt-BR');
    
    if(document.getElementById("criancasContainer") && document.getElementById("criancasContainer").children.length === 0) {
        adicionarCampoCrianca();
