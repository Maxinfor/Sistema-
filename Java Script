        `;
    });
    tbody.innerHTML = html;
}

function salvarAtendimento() {
    const editId = document.getElementById("editAtendimentoIndex").value;
    const cidadeSelect = document.getElementById("atendCidade").value;
    const cidadeOutra = document.getElementById("atendCidadeOutraInput").value.trim();
    const cidadeFinal = cidadeSelect === "Outra" ? cidadeOutra : cidadeSelect;

    const adminSelect = document.getElementById("atendAdmin").value;
    const adminOutro = document.getElementById("atendAdminOutraInput").value.trim();
    const adminFinal = adminSelect === "Outro" ? adminOutro : adminSelect;

    const dados = {
        nome: document.getElementById("atendNome").value,
        cidade: cidadeFinal,
        assunto: document.getElementById("atendAssuntoInput").value,
        admin: adminFinal,
        observacao: document.getElementById("observacaoAtendimento").value,
        data_hora: document.getElementById("atendDataHora").value
    };

    const acao = editId > 0 ? 'atualizar_atendimento' : 'salvar_atendimento';
    if(editId > 0) dados.id = editId;

    const formData = new URLSearchParams();
    for(const key in dados) formData.append(key, dados[key]);
    formData.append('acao', acao);

    fetch('index.php', { method: 'POST', body: formData })
        .then(res => res.json())
        .then(resp => {
            alert(resp.message || "Salvo!");
            limparFormAtendimento();
            carregarAtendimentos();
        });
}

function editarAtendimento(id) {
    fetch(`index.php?acao=buscar_atendimento&id=${id}`)
        .then(res => res.json())
        .then(item => {
            if(!item) return;
            document.getElementById("editAtendimentoIndex").value = item.id;
            document.getElementById("atendNome").value = item.nome || '';
            document.getElementById("atendAssuntoInput").value = item.assunto || '';
            document.getElementById("observacaoAtendimento").value = item.observacao || '';
            document.getElementById("atendDataHora").value = item.data_hora || '';

            const cSelect = document.getElementById("atendCidade");
            let achouC = false;
            for(let opt of cSelect.options) {
                if(opt.value === item.cidade) {
                    cSelect.value = item.cidade;
                    achouC = true;
                    break;
                }
            }
            if(!achouC && item.cidade) {
                cSelect.value = "Outra";
                document.getElementById("atendCidadeOutraContainer").style.display = "block";
                document.getElementById("atendCidadeOutraInput").value = item.cidade;
            } else {
                document.getElementById("atendCidadeOutraContainer").style.display = "none";
            }

            const aSelect = document.getElementById("atendAdmin");
            let achouA = false;
            for(let opt of aSelect.options) {
                if(opt.value === item.admin) {
                    aSelect.value = item.admin;
                    achouA = true;
                    break;
                }
            }
            if(!achouA && item.admin) {
                aSelect.value = "Outro";
                document.getElementById("atendAdminOutraContainer").style.display = "block";
                document.getElementById("atendAdminOutraInput").value = item.admin;
            } else {
                document.getElementById("atendAdminOutraContainer").style.display = "none";
            }

            document.getElementById("editAtendimentoIndicator").style.display = "flex";
            document.getElementById("editAtendimentoDisplay").textContent = item.nome;
            document.getElementById("btnSalvarAtendimentoTexto").textContent = "ATUALIZAR ATENDIMENTO";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
}

