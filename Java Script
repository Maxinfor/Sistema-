function configurarAutocompleteAssuntos() {
    const input = document.getElementById("assuntoInput");
    const listDiv = document.getElementById("assuntoAutocompleteList");
    if(!input || !listDiv) return;

    input.addEventListener("input", function() {
        const val = this.value.trim().toUpperCase();
        listDiv.innerHTML = "";
        if(!val) {
            listDiv.style.display = "none";
            return;
        }
        const matches = listaAssuntosPermitidos.filter(item => item.toUpperCase().includes(val));
        if(matches.length === 0) {
            listDiv.style.display = "none";
            return;
        }
        matches.forEach(m => {
            const div = document.createElement("div");
            div.innerHTML = m;
            div.addEventListener("click", function() {
                input.value = m;
                listDiv.style.display = "none";
            });
            listDiv.appendChild(div);
        });
        listDiv.style.display = "block";
    });

    document.addEventListener("click", function(e) {
        if(e.target !== input) listDiv.style.display = "none";
    });
}

