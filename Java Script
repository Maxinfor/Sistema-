    const dashUnicas = document.getElementById("dashPessoasUnicas");
    
    if(!tbody) return;
    contador.textContent = `TOTAL: ${dados.length}`;
    if(dashTotal) dashTotal.textContent = dados.length;

    const unicas = new Set(dados.map(i => i.nome.trim().toUpperCase())).size;
    if(dashUnicas) dashUnicas.textContent = unicas;

    if(dados.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-light); padding: 20px;">NENHUM ATENDIMENTO REGISTRADO.</td></tr>`;
        return;
    }

