function atualizarDataHoraHeader() {
    const el = document.getElementById("headerData");
    if (el) {
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        el.textContent = new Date().toLocaleDateString('pt-BR', options).toUpperCase();
    }
}

let processosCache = [];

function carregarProcessos(filtro = '') {
    fetch(`index.php?acao=listar_processos&filtro=${encodeURIComponent(filtro)}`)
        .then(res => res.json())
        .then(data => {
            processosCache = data;
            renderizarTabelaProcessos(data);
        })
        .catch(err => console.error("Erro ao carregar processos:", err));
}

function renderizarTabelaProcessos(dados) {
    const tbody = document.getElementById("tbodyRegistros");
    const contador = document.getElementById("contadorRegistros");
    if (!tbody) return;

    contador.textContent = `TOTAL: ${dados.length}`;

    if (dados.length === 0) {
        tbody.innerHTML = `<tr><td colspan="12" style="text-align: center; color: var(--text-light); padding: 20px;">NENHUM REGISTRO ENCONTRADO.</td></tr>`;
        return;
    }

    let html = "";
    dados.forEach((item) => {
        let criancasStr = "";
        try {
            const arr = JSON.parse(item.criancas_dados || '[]');
            criancasStr = arr.map(c => `${c.nome} (${c.nasc || 'N/I'})`).join('<br>');
        } catch(e) {
            criancasStr = item.criancas || '';
        }

        let responsaveisStr = "";
        try {
            const arr = JSON.parse(item.responsaveis_dados || '[]');
            responsaveisStr = arr.join('<br>');
        } catch(e) {
            responsaveisStr = item.responsavel || '';
        }

        html += `
            <tr>
                <td><strong>${item.pasta || ''}</strong></td>
                <td>${item.num_processo || ''}</td>
                <td>${criancasStr}</td>
                <td>-</td>
                <td>${responsaveisStr}</td>
                <td>${item.endereco || ''}</td>
                <td>${item.cidade || ''}</td>
                <td>${item.assunto || ''}</td>
                <td>${item.conselheiro || ''}</td>
                <td>${item.processo_sei || ''}</td>
                <td>${item.observacao || ''}</td>
                <td style="text-align: center; white-space: nowrap;">
                    <button type="button" class="btn-add" style="display:inline-flex; padding: 4px 8px; background: #e0f2fe; color: #0284c7;" onclick="abrirHistorico(${item.id}, '${item.pasta}')" title="Histórico"><i class="fa-solid fa-clock-rotate-left"></i></button>
                    <button type="button" class="btn-add" style="display:inline-flex; padding: 4px 8px; background: #fef3c7; color: #d97706; margin-left: 4px;" onclick="editarProcesso(${item.id})" title="Editar"><i class="fa-solid fa-pen"></i></button>
                    <button type="button" class="btn-remove" style="display:inline-flex; width: 24px; height: 24px; margin-left: 4px;" onclick="excluirProcesso(${item.id})" title="Excluir"><i class="fa-solid fa-trash"></i></button>
                </td>
            </tr>
        `;
    });
    tbody.innerHTML = html;
}

function pesquisarProcessos() {
    const termo = document.getElementById("inputPesquisaProcessos").value;
    carregarProcessos(termo);
}

function salvarRegistro() {
    const editId = document.getElementById("editIndex").value;
    const pasta = document.getElementById("pasta").value.trim();
    
    if(!pasta) {
        alert("Preencha o campo Pasta!");
        return;
    }

    const criancasRows = document.querySelectorAll("#criancasContainer .dynamic-item");
    let criancasDados = [];
    criancasRows.forEach(row => {
        const nome = row.querySelector(".nomeCrianca").value.trim();
        const nasc = row.querySelector(".nascCrianca").value.trim();
        if(nome) criancasDados.push({ nome, nasc });
    });

    const respRows = document.querySelectorAll("#responsaveisContainer .dynamic-item");
    let responsaveisDados = [];
    respRows.forEach(row => {
        const nome = row.querySelector(".nomeResponsavel").value.trim();
        if(nome) responsaveisDados.push(nome);
    });

    const cidadeSelect = document.getElementById("cidade").value;
    const cidadeOutra = document.getElementById("cidadeOutraInput").value.trim();
    const cidadeFinal = cidadeSelect === "Outra" ? cidadeOutra : cidadeSelect;

    const dados = {
        pasta: pasta,
        num_processo: document.getElementById("numProces").value.trim(),
        tipo_pessoa: document.getElementById("tipoPessoa").value,
        criancas_dados: JSON.stringify(criancasDados),
        responsaveis_dados: JSON.stringify(responsaveisDados),
        endereco: document.getElementById("endereco").value,
        cidade: cidadeFinal,
        assunto: document.getElementById("assuntoInput").value,
        conselheiro: document.getElementById("conselheiro").value,
        processo_sei: document.getElementById("processoSeiNum").value,
        observacao: document.getElementById("observacaoProcesso").value,
        pasta_importada: document.getElementById("pastaImportada").value
    };

    const acao = editId > 0 ? 'atualizar_processo' : 'salvar_processo';
    if(editId > 0) dados.id = editId;

    const formData = new URLSearchParams();
    for (const key in dados) {
        formData.append(key, dados[key]);
    }
    formData.append('acao', acao);

    fetch('index.php', {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(resp => {
        if(resp.success) {
            alert(resp.message || "Salvo com sucesso!");
            cancelarEdicao();
            carregarProcessos();
            atualizarDashboardEstatisticas();
        } else {
            alert("Erro ao salvar.");
        }
    })
    .catch(err => console.error("Erro:", err));
}

function editarProcesso(id) {
    fetch(`index.php?acao=buscar_processo&id=${id}`)
        .then(res => res.json())
        .then(item => {
            if(!item) return;
            document.getElementById("editIndex").value = item.id;
            document.getElementById("pasta").value = item.pasta || '';
            document.getElementById("numProces").value = item.num_processo || '';
            document.getElementById("tipoPessoa").value = item.tipo_pessoa || 'CRIANÇA';
            document.getElementById("endereco").value = item.endereco || '';
            document.getElementById("assuntoInput").value = item.assunto || '';
            document.getElementById("conselheiro").value = item.conselheiro || '';
            document.getElementById("processoSeiNum").value = item.processo_sei || '';
            document.getElementById("observacaoProcesso").value = item.observacao || '';
            document.getElementById("pastaImportada").value = item.pasta_importada || 0;

            const cidadeSelect = document.getElementById("cidade");
            let achou = false;
            for(let opt of cidadeSelect.options) {
                if(opt.value === item.cidade) {
                    cidadeSelect.value = item.cidade;
                    achou = true;
                    break;
                }
            }
            if(!achou && item.cidade) {
                cidadeSelect.value = "Outra";
                document.getElementById("cidadeOutraContainer").style.display = "block";
                document.getElementById("cidadeOutraInput").value = item.cidade;
            } else {
                document.getElementById("cidadeOutraContainer").style.display = "none";
            }

            const cContainer = document.getElementById("criancasContainer");
            cContainer.innerHTML = "";
            try {
                const arr = JSON.parse(item.criancas_dados || '[]');
                if(arr.length > 0) {
                    arr.forEach(c => adicionarCampoCrianca(c.nome, c.nasc));
                } else {
                    adicionarCampoCrianca(item.criancas || '');
                }
            } catch(e) {
                adicionarCampoCrianca(item.criancas || '');
            }

            const rContainer = document.getElementById("responsaveisContainer");
            rContainer.innerHTML = "";
            try {
                const arr = JSON.parse(item.responsaveis_dados || '[]');
                if(arr.length > 0) {
                    arr.forEach(r => adicionarCampoValor('responsaveisContainer', 'nomeResponsavel', r));
                } else {
                    adicionarCampoValor('responsaveisContainer', 'nomeResponsavel', item.responsavel || '');
                }
            } catch(e) {
                adicionarCampoValor('responsaveisContainer', 'nomeResponsavel', item.responsavel || '');
            }

            document.getElementById("editIndicator").style.display = "flex";
            document.getElementById("editPastaDisplay").textContent = item.pasta;
            document.getElementById("btnSalvarTexto").textContent = "ATUALIZAR";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
}

function cancelarEdicao() {
    document.getElementById("editIndex").value = "-1";
    document.getElementById("processoForm").reset();
    document.getElementById("editIndicator").style.display = "none";
    document.getElementById("btnSalvarTexto").textContent = "CADASTRAR";
    document.getElementById("criancasContainer").innerHTML = "";
    adicionarCampoCrianca();
    document.getElementById("responsaveisContainer").innerHTML = `
        <div class="dynamic-item">
            <input type="text" class="nomeResponsavel" placeholder="NOME COMPLETO">
            <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>
        </div>
    `;
}

function excluirProcesso(id) {
    if(!confirm("Deseja realmente excluir este processo?")) return;
    const formData = new URLSearchParams();
    formData.append('acao', 'excluir_processo');
    formData.append('id', id);

    fetch('index.php', { method: 'POST', body: formData })
        .then(() => {
            carregarProcessos();
            atualizarDashboardEstatisticas();
        });
}

function adicionarCampoCrianca(nome = '', nasc = '') {
    const container = document.getElementById("criancasContainer");
    const div = document.createElement("div");
    div.className = "dynamic-item";
    div.innerHTML = `
        <input type="text" class="nomeCrianca" placeholder="NOME DA CRIANÇA" value="${nome}" style="flex: 2;">
        <input type="text" class="nascCrianca" placeholder="NASC (DD/MM/AAAA)" value="${nasc}" style="flex: 1;">
        <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>
    `;
    container.appendChild(div);
    atualizarContadorCriancas();
}

function adicionarCampo(containerId, classeInput, placeholder) {
    const container = document.getElementById(containerId);
