    dados.forEach(item => {
        html += `
            <tr>
                <td>${item.data_hora || item.data_registro || ''}</td>
                <td><strong>${item.nome || ''}</strong></td>
                <td>${item.cidade || ''}</td>
                <td>${item.assunto || ''}</td>
                <td>${item.admin || ''}</td>
                <td>${item.observacao || ''}</td>
