function atualizarDashboardEstatisticas() {
    const mes = document.getElementById("filtroMes").value;
    const ano = document.getElementById("filtroAno").value;

    fetch(`index.php?acao=dashboard_assuntos&mes=${mes}&ano=${ano}`)
        .then(res => res.json())
        .then(data => {
            const ul = document.getElementById("listaAssuntosDash");
            const badge = document.getElementById("totalAssuntosCount");
            if(!ul) return;
            
            let total = 0;
            let html = "";
            for(let k in data) {
                total += parseInt(data[k]);
                html += `<li><span>${k}</span> <strong>${data[k]}</strong></li>`;
            }
            badge.textContent = total;
            ul.innerHTML = html || '<li style="color: var(--text-light); text-align: center; padding: 10px;">NENHUM DADO.</li>';
        });

    fetch(`index.php?acao=dashboard_cidades&mes=${mes}&ano=${ano}`)
        .then(res => res.json())
        .then(data => {
            const ul = document.getElementById("listaCidadesDash");
            const destaque = document.getElementById("regiaoDestaque");
            if(!ul) return;

            let html = "";
            let maiorVal = -1;
            let maiorNome = "---";
            for(let k in data) {
                if(data[k] > maiorVal) {
                    maiorVal = data[k];
                    maiorNome = k;
                }
                html += `<li><span>${k}</span> <strong>${data[k]}</strong></li>`;
            }
            destaque.textContent = `DESTAQUE: ${maiorNome} (${maiorVal >= 0 ? maiorVal : 0})`;
            ul.innerHTML = html || '<li style="color: var(--text-light); text-align: center; padding: 10px;">NENHUM DADO.</li>';
        });
}

